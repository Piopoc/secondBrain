views:
  - type: cards
    name: sum_IR
    filters:
      and:
        - file.inFolder("wiki/summaries/IR")
    order:
      - file.name
      - file.folder
      - file.mtime
    cardSize: 260
    imageAspectRatio: 1.3
    image: note.source
  - type: table
    name: concepts
    filters:
      and:
        - file.inFolder("wiki/concepts")
    order:
      - file.name
      - file.folder
      - file.ctime
      - file.tags
      - file.backlinks
    imageAspectRatio: 0.75
    cardSize: 210
    indentProperties: false
    rowHeight: medium
  - type: list
    name: entities
    filters:
      and:
        - file.inFolder("wiki/entities")
    order:
      - file.name
      - file.links
      - file.folder
    indentProperties: true
  - type: table
    name: exercises
    filters:
      and:
        - file.inFolder("wiki/exercises")
  - type: table
    name: synthesis
    filters:
      and:
        - file.inFolder("wiki/synthesis")
  - type: cards
    name: sumWA
    filters:
      and:
        - file.inFolder("wiki/summaries/WA")
    order:
      - file.name
      - file.folder
      - file.mtime
    image: note.source
    cardSize: 200
    imageAspectRatio: 1.3
